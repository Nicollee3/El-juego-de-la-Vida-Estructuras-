{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure ElJuegoDeLaVida",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "default"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build ElJuegoDeLaVida",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "default"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Configure ElJuegoDeLaVida",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build and Run ElJuegoDeLaVida",
            "type": "process",
            "command": "${workspaceFolder}\\out\\build\\ElJuegoDeLaVida.exe",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}\\out\\build",
                "env": {
                    "PATH": "C:\\mingw64\\bin;C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "dependsOn": "Build ElJuegoDeLaVida",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}